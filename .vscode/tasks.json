{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Blade Designer: Run",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "linux": {
        "command": "${workspaceFolder}/.venv/bin/python"
      },
      "args": [
        "main.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Blade Designer: Regression Tests",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "linux": {
        "command": "${workspaceFolder}/.venv/bin/python"
      },
      "args": [
        "tools/run_tests.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Blade Designer: Dependency Check",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "linux": {
        "command": "${workspaceFolder}/.venv/bin/python"
      },
      "args": [
        "-m",
        "pip",
        "check"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Blade Designer: Quick Tests",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": [
        "tools/run_tests.py",
        "--suite",
        "quick",
        "--brief"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Blade Designer: Ruff Check",
      "type": "process",
      "command": "${workspaceFolder}/artifacts/devtools/venv/Scripts/python.exe",
      "args": [
        "-m",
        "ruff",
        "check",
        "--config",
        "ruff.toml",
        "--no-cache",
        "blade_designer",
        "tests",
        "tools",
        "main.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
