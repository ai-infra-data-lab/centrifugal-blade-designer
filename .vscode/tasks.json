{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Blade Designer: Run",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "linux": {
        "command": "${workspaceFolder}/.venv/bin/python"
      },
      "args": [
        "main.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Blade Designer: Regression Tests",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "linux": {
        "command": "${workspaceFolder}/.venv/bin/python"
      },
      "args": [
        "tools/run_tests.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Blade Designer: Dependency Check",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "linux": {
        "command": "${workspaceFolder}/.venv/bin/python"
      },
      "args": [
        "-m",
        "pip",
        "check"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
